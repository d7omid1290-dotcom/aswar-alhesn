# اتركها فارغة للتشغيل المحلي (ذاكرة الخادم + بث SSE)
# املأها لتفعيل Supabase (قاعدة البيانات + الاتصال اللحظي) — مطلوبة عند النشر على Vercel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# واحد من الاثنين يكفي للخادم:
# (أ) مفتاح الخدمة
SUPABASE_SERVICE_ROLE_KEY=
# (ب) سرّ الخادم: نص عشوائي طويل يطابق private.config.server_secret (انظر migrations/0002)
SUPABASE_DB_SECRET=
