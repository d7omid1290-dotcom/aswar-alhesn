# ───── الوضع المحلي لا يحتاج أي متغير ─────
# لتفعيل اللعب عبر الإنترنت (Vercel + Supabase) املأ القيم التالية في إعدادات مشروع Vercel.

# يقرؤها المتصفح (آمنة للنشر، تُستخدم للاشتراك في البث اللحظي فقط):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# يقرؤها الخادم فقط (دالة /api على Vercel):
SUPABASE_URL=
SUPABASE_ANON_KEY=
# سر الخادم من جدول hisn_config بعد تشغيل الترحيل:
#   select value from public.hisn_config where key = 'server_secret';
HISN_SERVER_SECRET=
